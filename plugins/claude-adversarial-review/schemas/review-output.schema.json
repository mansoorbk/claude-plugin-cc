{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:uuid:45ebf4a1-7fc2-49ef-b0b8-bdd96b805f11",
  "title": "Bounded Claude adversarial review evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "confidence": { "$ref": "#/definitions/confidence" },
    "recommendation": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "next_steps": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "verdict": {
      "type": "string",
      "maxLength": 32,
      "enum": ["MATERIAL_FINDINGS", "NO_MATERIAL_FINDINGS_STATIC"]
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/definitions/finding" }
    }
  },
  "required": ["verdict", "findings", "confidence", "recommendation"],
  "definitions": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "severity": { "type": "string", "maxLength": 8, "enum": ["critical", "high", "medium"] },
        "claim": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "impact": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "recommendation": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "file": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "inference": { "type": "string", "maxLength": 8, "enum": ["direct", "inferred"] },
        "confidence": { "$ref": "#/definitions/confidence" }
      },
      "required": [
        "severity",
        "title",
        "claim",
        "impact",
        "evidence",
        "file",
        "line_start",
        "line_end",
        "inference",
        "confidence",
        "recommendation"
      ]
    }
  }
}
